# Laugh Lab Pro - Environment Variables
# Copy to .env.local and fill in your values

# ===================
# REQUIRED
# ===================

# Anthropic API Key - Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Vercel Token - Get yours at https://vercel.com/account/tokens
VERCEL_TOKEN=your_vercel_token_here

# ===================
# OPTIONAL (for Phase 2)
# ===================

# Supabase - Get yours at https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyxxxxx

# Stripe - Get yours at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
